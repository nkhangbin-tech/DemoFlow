var N,F:Integer;
procedure Check(const Name:string; OK:Boolean);
begin Inc(N); if OK then Writeln('PASS ',Name) else begin Inc(F); Writeln('FAIL ',Name); end; end;
var Obj:TWindowMock; Disp:IDispatch; V:OleVariant; Key:NativeUInt; Raised:Boolean;
begin
 Obj:=TWindowMock.Create; Disp:=Obj; Obj.HandleValue:=265152;
 try
  V:=Disp; Raised:=False;
  try Key:=NativeUInt(Int64(V.HWND)); except on E:EOleError do Raised:=True; end;
  Check('Late-bound HWND rejected by regression server',Raised and(Obj.NameCalls>0));
  Raised:=False;
  {$WARN SYMBOL_PLATFORM OFF}
  try Key:=NativeUInt(Cardinal(DocumentWindowDisp(Disp).HWND_)); except on E:EOleError do Raised:=True; end;
  {$WARN SYMBOL_PLATFORM ON}
  Check('Dispatch getter also rejected by regression server',Raised and(Obj.DispatchCalls>0));
  Obj.NameCalls:=0; Obj.DispatchCalls:=0;
  Key:=ReadDocumentWindowKey(Disp);
  Check('Typed interface retrieves verified window handle',Key=265152);
  Check('Vtable getter called exactly once',Obj.HandleCalls=1);
  Check('No HWND automation name lookup',Obj.NameCalls=0);
  Check('No HWND IDispatch Invoke',Obj.DispatchCalls=0);
  Obj.HandleValue:=-1;
  Check('Win64 zero-extends 32-bit OLE handle',ReadDocumentWindowKey(Disp)=NativeUInt(Cardinal($FFFFFFFF)));
  Obj.HandleValue:=0;
  Check('Zero handle is not fabricated',ReadDocumentWindowKey(Disp)=0);
  Obj.FailGetter:=True; Raised:=False;
  try Key:=ReadDocumentWindowKey(Disp); except on E:EOleSysError do Raised:=True; end;
  Check('Real getter exception propagates',Raised);
 except on E:Exception do Check(E.ClassName+': '+E.Message,False); end;
 VarClear(V); Disp:=nil;
 Writeln('Tests run: ',N); Writeln('Failures: ',F); if F<>0 then ExitCode:=1;
end.
